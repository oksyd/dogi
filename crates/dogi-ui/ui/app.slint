            Text { height: 17px; text: root.action; color: root.selected ? Theme.accent : Theme.text-muted; font-size: 10px; overflow: elide; vertical-stretch: 0; }
        }
    }

    chip-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ButtonDrawing inherits Rectangle {
