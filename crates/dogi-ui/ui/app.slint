    Rectangle { x: 186px; y: 272px; width: 19px; height: 1px; background: Theme.control-border; }
    Rectangle { x: 205px; y: 236px; width: 1px; height: 36px; background: Theme.control-border; }
    Rectangle { x: 205px; y: 236px; width: parent.width / 2 - 221px; height: 1px; background: Theme.control-border; }

    ControlChip { x: parent.width - 186px; y: 89px; number: "5"; title: SettingsTranslations.button(4); action: root.middle-action; selected: root.selected-button-index == 4; clicked => { root.selected-button-index = 4; } }
    Rectangle { x: parent.width / 2 + 41px; y: 116px; width: parent.width / 2 - 227px; height: 1px; background: Theme.control-border; }
    ControlChip { x: parent.width - 186px; y: 151px; number: "4"; title: SettingsTranslations.button(3); action: root.mode-shift-action; selected: root.selected-button-index == 3; clicked => { root.selected-button-index = 3; } }
    Rectangle { x: parent.width / 2 + 61px; y: 178px; width: parent.width / 2 - 247px; height: 1px; background: Theme.control-border; }

    ControlChip { x: (parent.width - 168px) / 2; y: parent.height - 64px; number: "3"; title: SettingsTranslations.button(2); action: root.gesture-action; selected: root.selected-button-index == 2; clicked => { root.selected-button-index = 2; } }
    Rectangle { x: parent.width / 2 - 82px; y: 251px; width: 1px; height: parent.height - 315px; background: Theme.control-border; }
    Rectangle { x: parent.width / 2 - 82px; y: parent.height - 64px; width: 42px; height: 1px; background: Theme.control-border; }

    Hotspot { x: parent.width / 2 - 30px; y: 222px; number: "1"; title: SettingsTranslations.button(0); selected: root.selected-button-index == 0; clicked => { root.selected-button-index = 0; } }
    Hotspot { x: parent.width / 2 - 41px; y: 188px; number: "2"; title: SettingsTranslations.button(1); selected: root.selected-button-index == 1; clicked => { root.selected-button-index = 1; } }
    Hotspot { x: parent.width / 2 - 96px; y: 237px; number: "3"; title: SettingsTranslations.button(2); selected: root.selected-button-index == 2; clicked => { root.selected-button-index = 2; } }
    Hotspot { x: parent.width / 2 + 47px; y: 164px; number: "4"; title: SettingsTranslations.button(3); selected: root.selected-button-index == 3; clicked => { root.selected-button-index = 3; } }
    Hotspot { x: parent.width / 2 + 27px; y: 102px; number: "5"; title: SettingsTranslations.button(4); selected: root.selected-button-index == 4; clicked => { root.selected-button-index = 4; } }
}

