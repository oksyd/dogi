import {
    ListView,
    Palette,
} from "std-widgets.slint";

import {
    AppProfileRow,
    DesktopRuntimeState,
    DeviceAccessState,
    DeviceDiscoveryState,
    DeviceRow,
    PlanRow,
    PlanScope,
    UiMessage,
    UiStatus,
    UiStatusKind,
    UpdateState,
} from "view-models.slint";

import {
    DeviceTranslations,
    SettingsTranslations,
    StatusTranslations,
} from "i18n.slint";

import { Theme } from "theme.slint";
import { BrandWordmark } from "brand.slint";
import { FormComboBox, FormLineEdit } from "controls.slint";
import { DeviceConfigSkeleton, DiscoveryPageSkeleton } from "loading.slint";
import { Master3sDrawing } from "mouse.slint";
import { BoltReceiverDrawing } from "receiver.slint";

enum BadgeTone {
    neutral,
    accent,
    success,
    warning,
    danger,
}

component Label inherits Text {
    height: 20px;
    color: Theme.text;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
    vertical-stretch: 0;
}

component Hint inherits Text {
    color: Theme.text-muted;
    font-size: 11px;
    wrap: word-wrap;
    vertical-stretch: 0;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
    vertical-stretch: 0;
}

component FocusableArea {
    in property <bool> enabled: true;
    out property <bool> pressed <=> pointer-area.pressed;
    out property <bool> has-hover <=> pointer-area.has-hover;
    out property <bool> has-focus <=> focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;

    pointer-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> title;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> warning: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    border-radius: 5px;
    border-width: button-area.has-focus ? 2px : root.primary ? 0px : 1px;
    border-color: button-area.has-focus ? (root.warning ? Theme.warning : Theme.accent) : root.destructive ? Theme.danger : root.warning ? Theme.warning-border : Theme.control-border;
    background: !root.enabled ? Theme.surface : root.primary ? (button-area.pressed ? Theme.accent-bg-active : button-area.has-hover ? Theme.accent-bg-hover : Theme.accent-bg) : root.warning ? (button-area.pressed ? Theme.warning-border : button-area.has-hover ? Theme.warning-bg : Theme.panel) : button-area.pressed ? Theme.selected : button-area.has-hover ? Theme.hover : Theme.panel;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.title;
        color: !root.enabled ? Theme.text-faint : root.primary ? Theme.accent-text : root.destructive ? Theme.danger : root.warning ? Theme.warning : Theme.text;
        font-size: 11px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MetaBadge inherits Rectangle {
    in property <string> title;
    in property <BadgeTone> tone: BadgeTone.neutral;

    height: 24px;
    min-width: 54px;
    border-radius: 12px;
    background: root.tone == BadgeTone.warning ? Theme.warning-bg
        : root.tone == BadgeTone.success ? Theme.success-soft
        : root.tone == BadgeTone.accent ? Theme.accent-soft
        : root.tone == BadgeTone.danger ? Theme.danger-bg
        : Theme.surface;
    border-width: Theme.high-contrast || root.tone == BadgeTone.neutral ? 1px : 0px;
    border-color: root.tone == BadgeTone.warning ? Theme.warning
        : root.tone == BadgeTone.success ? Theme.success
        : root.tone == BadgeTone.accent ? Theme.accent
        : root.tone == BadgeTone.danger ? Theme.danger
        : Theme.control-border;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.title;
        color: root.tone == BadgeTone.warning ? Theme.warning
            : root.tone == BadgeTone.success ? Theme.success
            : root.tone == BadgeTone.accent ? Theme.accent
            : root.tone == BadgeTone.danger ? Theme.danger
            : Theme.text-muted;
        font-size: 10px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component WarningBar inherits Rectangle {
    in property <string> message;

    height: 46px;
    background: Theme.warning-bg;
    border-width: 1px;
    border-color: Theme.warning-border;
    border-radius: 6px;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        VerticalLayout {
            width: 20px;
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.warning-border;
                vertical-stretch: 0;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "!";
                    color: Theme.warning;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: root.message;
            color: Theme.warning-text;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component DeviceAccessNotice inherits Rectangle {
    in property <string> title;
    in property <string> message;

    height: 56px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 7px;
    clip: true;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 11px;

        VerticalLayout {
            width: 20px;
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.warning-bg;
                vertical-stretch: 0;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "!";
                    color: Theme.warning;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;

            Text {
                height: 18px;
                text: root.title;
                color: Theme.text;
                font-size: 11px;
                font-weight: 650;
                vertical-stretch: 0;
            }
            Text {
                height: 17px;
                text: root.message;
                color: Theme.text-muted;
                font-size: 10px;
                overflow: elide;
                vertical-stretch: 0;
            }
        }
    }
}

component AccentSlider inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value: minimum;
    in property <bool> enabled: true;
    callback edited();

    height: 28px;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.value = min(root.maximum, root.value + root.step); root.edited(); }
    accessible-action-decrement => { root.value = max(root.minimum, root.value - root.step); root.edited(); }

    function set-from-position(position: length) {
        root.value = root.minimum + round(clamp((position - 9px) / (root.width - 18px), 0, 1) * (root.maximum - root.minimum) / root.step) * root.step;
        root.edited();
    }

    Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 18px;
        height: 4px;
        border-radius: 2px;
        background: Theme.control-border;
    }

    Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: clamp((parent.width - 18px) * (root.value - root.minimum) / (root.maximum - root.minimum), 0px, parent.width - 18px);
        height: 4px;
        border-radius: 2px;
        background: Theme.accent-bg;
    }

    Rectangle {
        x: clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0px, parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: slider-area.pressed ? 18px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.panel;
        border-width: slider-focus.has-focus ? 3px : 2px;
        border-color: Theme.accent;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
    }

    slider-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            slider-focus.focus();
            root.set-from-position(self.mouse-x);
        }
        moved => { if (self.pressed) { root.set-from-position(self.mouse-x); } }
    }

    forward-focus: slider-focus;

    slider-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = min(root.maximum, root.value + root.step);
                root.edited();
                return accept;
            } else if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = max(root.minimum, root.value - root.step);
                root.edited();
                return accept;
            } else if (event.text == Key.Home) {
                root.value = root.minimum;
                root.edited();
                return accept;
            } else if (event.text == Key.End) {
                root.value = root.maximum;
                root.edited();
                return accept;
            }
            return reject;
        }
    }
}

component AccentSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? (switch-area.has-hover ? Theme.accent-bg-hover : Theme.accent-bg) : switch-area.has-hover ? Theme.hover : Theme.surface;
    border-width: switch-area.has-focus ? 2px : root.checked ? 0px : 1px;
    border-color: switch-area.has-focus ? Theme.accent : Theme.control-border;
    opacity: root.enabled ? 1 : 0.5;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.accent-text : Theme.text-faint;

        animate x { duration: 120ms; easing: ease-out; }
    }

    switch-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(); }
    }
}

component SliderRow inherits Rectangle {
    in property <string> title;
    in property <string> suffix;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback edited();

    height: 70px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 24px;

        Text {
            width: 235px;
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;

            Text {
                height: 22px;
                text: round(root.value) + root.suffix;
                color: Theme.text;
                font-size: 11px;
                font-weight: 650;
                horizontal-alignment: right;
                vertical-stretch: 0;
            }

            AccentSlider {
                height: 28px;
                label: root.title;
                minimum: root.minimum;
                maximum: root.maximum;
                step: 1;
                value <=> root.value;
                enabled: root.enabled;
                edited => { root.edited(); }
                vertical-stretch: 0;
            }
        }
    }
}

component HorizontalScrollTest inherits Rectangle {
    in property <float> current-speed: 100;
    in property <bool> enabled: true;
    in-out property <bool> open: false;
    in-out property <int> mode-index: 1;
    in property <bool> active: false;
    in property <bool> busy: false;
    in property <string> detail;
    in property <bool> compact: false;
    in-out property <bool> moved: false;
    callback toggled(bool);
    callback mode-selected(int);

    private property <length> track-offset: 0px;

    height: root.open ? (root.compact ? 90px : 108px) : (root.compact ? 46px : 52px);
    background: transparent;
    clip: true;

    changed open => {
        if (!root.open) {
            root.track-offset = 0px;
            root.moved = false;
        }
    }

    VerticalLayout {
        spacing: 0px;

        HorizontalLayout {
            height: root.compact ? 35px : 41px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 12px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 9px;

                VerticalLayout {
                    width: 8px;
                    horizontal-stretch: 0;
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        background: root.active ? Theme.success
                            : root.busy ? Theme.accent
                            : Theme.text-faint;
                        vertical-stretch: 0;
                    }
                }

                Text {
                    text: @tr("Test horizontal scrolling");
                    color: root.enabled ? Theme.text : Theme.text-faint;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            if root.open : HorizontalLayout {
                width: 224px;
                spacing: 4px;
                horizontal-stretch: 0;

                Rectangle {
                    width: 90px;
                    height: 30px;
                    border-radius: 5px;
                    background: root.mode-index == 0 ? Theme.accent-soft
                        : baseline-area.has-hover ? Theme.hover
                        : transparent;
                    border-width: root.mode-index == 0 ? 1px : 0px;
                    border-color: root.mode-index == 0 ? Theme.accent : transparent;
                    Text {
                        text: @tr("Baseline · 100%");
                        color: root.mode-index == 0 ? Theme.accent : Theme.text-muted;
                        font-size: 10px;
                        font-weight: root.mode-index == 0 ? 650 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    baseline-area := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: enabled ? pointer : default;
                        clicked => {
                            root.mode-index = 0;
                            root.mode-selected(0);
                            root.track-offset = 0px;
                            root.moved = false;
                        }
                    }
                }

                Rectangle {
                    width: 130px;
                    height: 30px;
                    border-radius: 5px;
                    background: root.mode-index == 1 ? Theme.accent-soft
                        : current-area.has-hover ? Theme.hover
                        : transparent;
                    border-width: root.mode-index == 1 ? 1px : 0px;
                    border-color: root.mode-index == 1 ? Theme.accent : transparent;
                    Text {
                        text: @tr("Current · {}%", round(root.current-speed));
                        color: root.mode-index == 1 ? Theme.accent : Theme.text-muted;
                        font-size: 10px;
                        font-weight: root.mode-index == 1 ? 650 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    current-area := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: enabled ? pointer : default;
                        clicked => {
                            root.mode-index = 1;
                            root.mode-selected(1);
                            root.track-offset = 0px;
                            root.moved = false;
                        }
                    }
                }
            }

            ActionButton {
                width: 76px;
                height: 30px;
                title: !root.enabled ? @tr("Unavailable")
                    : root.busy ? @tr("Starting…")
                    : root.open ? @tr("Stop")
                    : @tr("Test");
                enabled: root.enabled && !root.busy;
                primary: !root.open;
                clicked => {
                    root.open = !root.open;
                    root.toggled(root.open);
                }
                horizontal-stretch: 0;
            }
        }

        if root.open : Rectangle {
            height: root.compact ? 54px : 66px;
            background: Theme.surface;
            border-width: 1px;
            border-color: root.detail != "" ? Theme.warning-border : Theme.border;
            clip: true;

            if root.detail != "" : Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: root.detail;
                color: Theme.warning-text;
                font-size: 10px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.detail == "" : Rectangle {
                x: 12px;
                y: 7px;
                width: parent.width - 24px;
                height: parent.height - 14px;
                background: Theme.panel;
                border-width: test-area.has-hover ? 2px : 1px;
                border-color: test-area.has-hover ? Theme.accent : Theme.border;
                border-radius: 6px;
                clip: true;

                HorizontalLayout {
                    x: root.track-offset - 188px;
                    y: 0px;
                    width: 900px;
                    height: parent.height;
                    spacing: 8px;

                    for label in ["01", "02", "03", "04", "05", "06", "07", "08", "09"] : Rectangle {
                        width: 92px;
                        background: transparent;
                        horizontal-stretch: 0;

                        Rectangle {
                            x: 0px;
                            y: 11px;
                            width: 1px;
                            height: parent.height - 22px;
                            background: Theme.border;
                        }

                        Text {
                            x: 10px;
                            width: parent.width - 10px;
                            height: parent.height;
                            text: label;
                            color: Theme.text-faint;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if !root.moved : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 122px;
                    height: 28px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 14px;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("Roll the thumb wheel");
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                test-area := TouchArea {
                    mouse-cursor: col-resize;
                    scroll-event(event) => {
                        if (event.delta-x != 0px) {
                            root.track-offset = clamp(
                                root.track-offset + event.delta-x,
                                -260px,
                                260px,
                            );
                            root.moved = true;
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback edited();

    height: 52px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 18px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        VerticalLayout {
            width: 44px;
            horizontal-stretch: 0;
            alignment: center;

            AccentSwitch {
                width: 44px;
                label: root.title;
                checked <=> root.checked;
                enabled: root.enabled;
                toggled => { root.edited(); }
                vertical-stretch: 0;
            }
        }
    }
}

component SelectRow inherits Rectangle {
    in property <string> title;
    in property <[string]> options;
    in-out property <int> current-index;
    in property <string> badge;
    in property <BadgeTone> badge-tone: BadgeTone.neutral;
    in property <bool> enabled: true;
    callback edited();

    height: 54px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 18px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.badge != "" : VerticalLayout {
            width: 66px;
            horizontal-stretch: 0;
            alignment: center;

            MetaBadge {
                width: parent.width;
                title: root.badge;
                tone: root.badge-tone;
            }
        }

        VerticalLayout {
            width: 196px;
            horizontal-stretch: 0;
            alignment: center;

            FormComboBox {
                width: parent.width;
                height: 34px;
                accessible-label: root.title;
                model: root.options;
                current-index <=> root.current-index;
                enabled: root.enabled;
                selected(value) => { root.edited(); }
                vertical-stretch: 0;
            }
        }
    }
}

component WheelModeRow inherits Rectangle {
    in-out property <int> current-index;
    callback edited();

    height: 54px;
    background: transparent;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 18px;

        Text {
            text: @tr("Scroll mode");
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        VerticalLayout {
            width: 196px;
            horizontal-stretch: 0;
            alignment: center;

            FormComboBox {
                width: parent.width;
                height: 34px;
                accessible-label: @tr("Scroll mode");
                model: [
                    SettingsTranslations.wheel-mode(0),
                    SettingsTranslations.wheel-mode(1),
                    SettingsTranslations.wheel-mode(2),
                ];
                current-index <=> root.current-index;
                selected(value) => { root.edited(); }
                vertical-stretch: 0;
            }
        }
    }
}

component DeviceListItem inherits Rectangle {
    in property <string> name;
    in property <string> connection;
    in property <string> battery;
    in property <string> accessibility-status;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> is-mouse;
    in property <bool> selected;
    callback clicked();

    height: 72px;
    background: root.selected ? Theme.sidebar-selected : device-area.has-hover ? Theme.sidebar-hover : transparent;
    border-radius: 7px;
    border-width: device-area.has-focus ? 2px : Theme.high-contrast && root.selected ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: root.name
        + ", " + root.connection
        + (root.battery == "" ? "" : ", " + root.battery)
        + ", " + root.accessibility-status;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 11px;

        VerticalLayout {
            width: 34px;
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                width: 34px;
                height: 46px;
                background: transparent;
                vertical-stretch: 0;

                if root.is-mouse : Path {
                    x: 5px;
                    y: 2px;
                    width: 24px;
                    height: 40px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 40;
                    commands: "M12 1 C5 1 2 7 2 16 L2 25 C2 34 6 39 12 39 C18 39 22 34 22 25 L22 16 C22 7 19 1 12 1 Z";
                    fill: root.selected ? Theme.sidebar-text : Theme.sidebar-icon;
                    stroke: root.selected ? Theme.sidebar-text : Theme.sidebar-muted;
                    stroke-width: 1px;
                }

                if root.is-mouse : Rectangle {
                    x: 16px;
                    y: 5px;
                    width: 1px;
                    height: 13px;
                    background: root.selected ? Theme.sidebar-muted : Theme.sidebar-text;
                }

                if root.is-mouse : Rectangle {
                    x: 13px;
                    y: 8px;
                    width: 7px;
                    height: 11px;
                    border-radius: 4px;
                    background: Theme.sidebar;
                }

                if !root.is-mouse : BoltReceiverDrawing {
                    x: 3px;
                    y: 6px;
                    width: 28px;
                    height: 34px;
                }
            }
        }

        VerticalLayout {
            spacing: 1px;
            alignment: center;

            Text {
                height: 21px;
                text: root.name;
                color: Theme.sidebar-text;
                font-size: 11px;
                font-weight: root.selected ? 650 : 500;
                overflow: elide;
                vertical-stretch: 0;
            }

            HorizontalLayout {
                height: 18px;
                spacing: 6px;
                vertical-stretch: 0;

                VerticalLayout {
                    width: 6px;
                    horizontal-stretch: 0;
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.busy ? Theme.accent
                            : root.ready ? Theme.success
                            : Theme.warning;
                        vertical-stretch: 0;
                    }
                }

                Text {
                    text: root.busy
                        ? root.connection + "  ·  " + root.accessibility-status
                        : root.battery == ""
                        ? root.connection + (root.ready ? "" : "  ·  " + root.accessibility-status)
                        : root.connection + "  ·  " + root.battery;
                    color: Theme.sidebar-muted;
                    font-size: 10px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }

    device-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SidebarSettingsItem inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    in property <bool> attention;
    callback clicked();

    height: 42px;
    border-radius: 7px;
    border-width: settings-area.has-focus ? 2px : Theme.high-contrast && root.selected ? 1px : 0px;
    border-color: Theme.accent;
    background: root.selected ? Theme.sidebar-selected : settings-area.has-hover ? Theme.sidebar-hover : transparent;
    accessible-role: button;
    accessible-label: root.attention ? @tr("Settings · Update available") : root.title;
    accessible-action-default => { root.clicked(); }
    vertical-stretch: 0;

    Rectangle {
        x: 12px;
        y: 12px;
        width: 18px;
        height: 18px;
        background: transparent;

        Rectangle { x: 1px; y: 3px; width: 16px; height: 1px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-muted; }
        Rectangle { x: 1px; y: 9px; width: 16px; height: 1px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-muted; }
        Rectangle { x: 1px; y: 15px; width: 16px; height: 1px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-muted; }
        Rectangle { x: 5px; y: 1px; width: 4px; height: 5px; border-radius: 2px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-icon; }
        Rectangle { x: 11px; y: 7px; width: 4px; height: 5px; border-radius: 2px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-icon; }
        Rectangle { x: 3px; y: 13px; width: 4px; height: 5px; border-radius: 2px; background: root.selected ? Theme.sidebar-text : Theme.sidebar-icon; }
    }

    Text {
        x: 42px;
        width: parent.width - (root.attention ? 70px : 54px);
        height: parent.height;
        text: root.title;
        color: root.selected ? Theme.sidebar-text : Theme.sidebar-muted;
        font-size: 11px;
        font-weight: root.selected ? 650 : 500;
        vertical-alignment: center;
    }

    if root.attention : Rectangle {
        x: parent.width - 20px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
    }

    settings-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TaskTab inherits Rectangle {
    in-out property <int> current-index;
    in property <int> index;
    in property <string> title;
    in property <bool> enabled: true;

    width: 148px;
    background: root.enabled
        ? (tab-area.has-focus ? Theme.selected : tab-area.has-hover ? Theme.surface : transparent)
        : transparent;
    opacity: root.enabled ? 1 : 0.56;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.current-index = root.index; } }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.title;
        color: root.current-index == root.index ? Theme.text : Theme.text-muted;
        font-size: 11px;
        font-weight: root.current-index == root.index ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 22px;
        y: parent.height - 3px;
        width: parent.width - 44px;
        height: 3px;
        border-radius: 2px;
        background: root.current-index == root.index ? Theme.accent : transparent;
    }

    tab-area := FocusableArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.current-index = root.index; }
    }
}

component PageHeading inherits VerticalLayout {
    in property <string> title;

    height: 28px;
    spacing: 0px;
    vertical-stretch: 0;

    Text {
        height: 28px;
        text: root.title;
        color: Theme.text;
        font-size: 17px;
        font-weight: 650;
        vertical-alignment: center;
        vertical-stretch: 0;
    }
}

component DeviceDrawing inherits Rectangle {
    in property <bool> connected;
    in property <bool> detected;
    in property <bool> busy: false;
    in property <bool> receiver-detected: false;
    in property <int> interface-count: 0;
    in property <string> connection-label;
    in property <float> pointer-speed;
    in property <string> wheel-mode;
    in property <string> thumb-mode;
    property <string> status-label:
        root.busy ? @tr("Identifying…")
        : root.connected ? @tr("Connected")
        : root.detected ? @tr("Detected")
        : @tr("Offline");

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;

    Text {
        x: 20px;
        y: 17px;
        width: parent.width - 40px;
        height: 20px;
        text: root.receiver-detected
            ? @tr("Receiver overview")
            : root.detected ? @tr("Device overview")
            : @tr("Preview");
        color: Theme.text;
        font-size: 12px;
        font-weight: 600;
    }

    Rectangle {
        x: 20px;
        y: 43px;
        width: root.busy ? 102px : 88px;
        height: 24px;
        border-radius: 12px;
        background: root.busy ? Theme.accent-soft
            : root.connected ? Theme.success-soft
            : Theme.surface;

        Rectangle {
            x: 10px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.busy ? Theme.accent
                : root.connected ? Theme.success
                : root.detected ? Theme.text-muted
                : Theme.text-faint;
        }

        Text {
            x: 23px;
            width: 57px;
            height: parent.height;
            text: root.status-label;
            color: root.busy ? Theme.accent
                : root.connected ? Theme.success
                : Theme.text-muted;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    if !root.receiver-detected : Master3sDrawing {
        width: root.connected ? 190px : 152px;
        height: root.connected ? 306px : 244px;
        x: (parent.width - self.width) / 2;
        y: root.connected ? 76px : 82px;
        connected: root.connected;
    }

    if root.receiver-detected : BoltReceiverDrawing {
        x: (parent.width - self.width) / 2;
        y: 91px;
        width: 190px;
        height: 210px;
    }

    Rectangle {
        x: 20px;
        y: parent.height - 82px;
        width: parent.width - 40px;
        height: 62px;
        background: Theme.surface;
        border-radius: 6px;

        if !root.receiver-detected : HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: round(root.pointer-speed) + "%"; color: Theme.text; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Pointer"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
            VerticalLayout {
                width: 1px;
                horizontal-stretch: 0;
                alignment: center;
                Rectangle { width: 1px; height: 30px; background: Theme.border; vertical-stretch: 0; }
            }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: root.wheel-mode; color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Main wheel"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
            VerticalLayout {
                width: 1px;
                horizontal-stretch: 0;
                alignment: center;
                Rectangle { width: 1px; height: 30px; background: Theme.border; vertical-stretch: 0; }
            }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: root.thumb-mode; color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Thumb wheel"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
        }

        if root.receiver-detected : HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: root.connection-label; color: Theme.text; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Transport"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
            VerticalLayout {
                width: 1px;
                horizontal-stretch: 0;
                alignment: center;
                Rectangle { width: 1px; height: 30px; background: Theme.border; vertical-stretch: 0; }
            }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: @tr("USB"); color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Interface"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
            VerticalLayout {
                width: 1px;
                horizontal-stretch: 0;
                alignment: center;
                Rectangle { width: 1px; height: 30px; background: Theme.border; vertical-stretch: 0; }
            }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                Text { height: 18px; text: root.interface-count; color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
                Text { height: 18px; text: @tr("Interfaces"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 0; }
            }
        }
    }
}

