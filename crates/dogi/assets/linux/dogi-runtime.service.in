# Generated by Dogi. Manual changes will be replaced.
# Executable-Revision: @DOGI_EXECUTABLE_REVISION@
[Unit]
Description=Dogi desktop runtime
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@DOGI_EXECUTABLE@ runtime run --idle-timeout-ms 1000 --execute-actions --allow-device-write
Restart=on-failure
RestartSec=2
RuntimeDirectory=dogi
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
